# Copy to .env and adjust. .env is never committed; on the server it lives next to the
# checkout and the deploy job refuses to run without it.

# Compose project name: fixes container, network and volume names no matter what the
# checkout directory is called.
COMPOSE_PROJECT_NAME=notes-demo

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=appdb

# Port nginx is published on.
HTTP_PORT=8080

# Time zone of the containers. The backup schedule below is in this zone.
TZ=UTC

# Daily database backup (backup/backup.sh).
BACKUP_TIME=22:00
BACKUP_RETENTION_DAYS=30
# Host directory for the dumps. Empty = a docker named volume.
BACKUP_HOST_DIR=

# Daily error report: how report days are cut, as hours from UTC (8 for UTC+8, -5 for UTC-5).
# Keep it consistent with TZ so "no backup at BACKUP_TIME" is checked in the same zone.
REPORT_UTC_OFFSET=0
REPORT_PROJECT=notes-demo
